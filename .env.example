# CaseVault configuration. Copy to .env only when overriding defaults.
# Local defaults store SQLite and encrypted evidence under backend/data/.
# DATABASE_URL=sqlite:///C:/absolute/path/to/casevault.db
# UPLOAD_DIR=C:/absolute/path/to/uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Use a 64-character hex key from a secure secret manager in deployed environments.
# If omitted, a random key is created in the data directory. Back it up with the database.
# DMS_MASTER_KEY=

# One-time first administrator setup token. If omitted, a random token is written
# as bytes to backend/data/casevault.setup-token. Enter its hex representation.
# DMS_SETUP_TOKEN=

# Optional separate frontend hosting origin. Same-origin Docker hosting needs no value.
VITE_API_BASE=
